{
  "name": "zotero-ragflow",
  "type": "module",
  "version": "0.1.2",
  "description": "连接 Zotero 和 RAGFlow，用于构建知识库并进行知识问答",
  "config": {
    "addonName": "Zotero RAGFlow",
    "addonID": "zoteroragflow@yourname.com",
    "addonRef": "zoteroragflow",
    "addonInstance": "RAGFlow",
    "prefsPrefix": "extensions.zotero.zoteroragflow"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuGuangHeng/zotero-ragflow.git"
  },
  "author": "wuguangheng",
  "bugs": {
    "url": "https://github.com/WuGuangHeng/zotero-ragflow/issues"
  },
  "homepage": "https://github.com/WuGuangHeng/zotero-ragflow#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "echo \"Error: no test specified\" && exit 1",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@eslint/eslintrc": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "typescript-plugin-css-modules": "^5.0.1",
    "postcss": "^8.4.31",
    "postcss-modules": "^6.0.0",
    "postcss-loader": "^7.3.3",
    "postcss-preset-env": "^9.4.0",
    "postcss-color-mod-function": "^3.0.3",
    "postcss-custom-properties": "^13.3.6",
    "postcss-nesting": "^12.0.4",
    "autoprefixer": "^10.4.19",
    "style-loader": "^3.3.3",
    "css-loader": "^6.8.1",
    "zotero-plugin-scaffold": "^0.2.4",
    "zotero-types": "^3.1.7"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
